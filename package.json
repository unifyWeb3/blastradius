{
  "name": "blastradius",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "vite build",
    "start": "node --import tsx src/server/server.ts",
    "fixture:validate": "node --import tsx scripts/validate-fixture.ts",
    "hydra:ingest": "node --import tsx scripts/ingest-fixture.ts",
    "hydra:verify": "node --import tsx scripts/verify-query-contract.ts",
    "hydra:acceptance": "pnpm hydra:ingest && pnpm hydra:verify",
    "ui:smoke": "node --import tsx scripts/browser-smoke.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify:static": "pnpm fixture:validate && pnpm test && pnpm typecheck && pnpm build"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vite": "7.3.6",
    "vitest": "^3.1.4"
  },
  "dependencies": {
    "@xyflow/react": "12.10.0",
    "lucide-react": "0.468.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  }
}
