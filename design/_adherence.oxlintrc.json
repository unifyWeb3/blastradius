        "selector": "JSXOpeningElement[name.name='FullScreenState'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|danger)$/]",
        "message": "<FullScreenState> tone must be one of 'default' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GraphLegend'] > JSXAttribute > JSXIdentifier[name!=/^(?:keys|direction|key|ref|className|style|children)$/]",
        "message": "<GraphLegend> doesn't accept that prop. Declared props: keys, direction."
