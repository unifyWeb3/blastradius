{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/evidence/**",
              "components/feedback/**",
              "components/graph/**",
              "components/layout/**",
              "components/status/**",
              "ui_kits/console/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:IBM Plex Mono|IBM Plex Sans|IBM Plex Sans Condensed))/i]",
        "message": "Font not provided by the design system. Available: IBM Plex Mono, IBM Plex Sans, IBM Plex Sans Condensed."
      },
      {
        "selector": "JSXOpeningElement[name.name='ApplicationRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|status|hopCount|detail|selected|onSelect|style|key|ref|className|style|children)$/]",
        "message": "<ApplicationRow> doesn't accept that prop. Declared props: name, status, hopCount, detail, selected, onSelect, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ApplicationRow'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:exposed|not_exposed|unresolved|no_path|neutral)$/]",
        "message": "<ApplicationRow> status must be one of 'exposed' | 'not_exposed' | 'unresolved' | 'no_path' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|trailingIcon|loading|disabled|block|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, trailingIcon, loading, disabled, block, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|quiet)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'quiet'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Button> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChainNode'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|detail|role|index|key|ref|className|style|children)$/]",
        "message": "<ChainNode> doesn't accept that prop. Declared props: name, detail, role, index."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChainNode'] > JSXAttribute[name.name='role'] > Literal[value!=/^(?:application|dependency|compromised)$/]",
        "message": "<ChainNode> role must be one of 'application' | 'dependency' | 'compromised'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CheckResult'] > JSXAttribute > JSXIdentifier[name!=/^(?:reason|hopCount|showReasonCode|key|ref|className|style|children)$/]",
        "message": "<CheckResult> doesn't accept that prop. Declared props: reason, hopCount, showReasonCode."
      },
      {
        "selector": "JSXOpeningElement[name.name='CheckResult'] > JSXAttribute[name.name='reason'] > Literal[value!=/^(?:supporting_dependency_path|no_common_overlap|no_supporting_dependency_path|missing_dependency_validity)$/]",
        "message": "<CheckResult> reason must be one of 'supporting_dependency_path' | 'no_common_overlap' | 'no_supporting_dependency_path' | 'missing_dependency_validity'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|sublabel|busy|height|grid|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: icon, label, sublabel, busy, height, grid."
      },
      {
        "selector": "JSXOpeningElement[name.name='ErrorBanner'] > JSXAttribute > JSXIdentifier[name!=/^(?:message|onDismiss|key|ref|className|style|children)$/]",
        "message": "<ErrorBanner> doesn't accept that prop. Declared props: message, onDismiss."
      },
      {
        "selector": "JSXOpeningElement[name.name='EvidenceRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:relationshipType|evidence|interval|key|ref|className|style|children)$/]",
        "message": "<EvidenceRow> doesn't accept that prop. Declared props: relationshipType, evidence, interval."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|invalid|mono|inputProps|children|key|ref|className|style|children)$/]",
        "message": "<Field> doesn't accept that prop. Declared props: label, hint, invalid, mono, inputProps, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='FullScreenState'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|detail|tone|busy|key|ref|className|style|children)$/]",
        "message": "<FullScreenState> doesn't accept that prop. Declared props: icon, label, detail, tone, busy."
