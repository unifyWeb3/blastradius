        "selector": "JSXOpeningElement[name.name='SeverityBadge'] > JSXAttribute[name.name='severity'] > Literal[value!=/^(?:critical|high|moderate|low)$/]",
        "message": "<SeverityBadge> severity must be one of 'critical' | 'high' | 'moderate' | 'low'."
