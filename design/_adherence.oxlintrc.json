      {
        "selector": "JSXOpeningElement[name.name='GraphLegend'] > JSXAttribute[name.name='direction'] > Literal[value!=/^(?:row|column)$/]",
        "message": "<GraphLegend> direction must be one of 'row' | 'column'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GraphNode'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|detail|kind|status|selected|dimmed|clickable|onSelect|key|ref|className|style|children)$/]",
        "message": "<GraphNode> doesn't accept that prop. Declared props: name, detail, kind, status, selected, dimmed, clickable, onSelect."
      },
      {
        "selector": "JSXOpeningElement[name.name='GraphNode'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:application|version|compromised)$/]",
        "message": "<GraphNode> kind must be one of 'application' | 'version' | 'compromised'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GraphNode'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:exposed|not_exposed|unresolved)$/]",
        "message": "<GraphNode> status must be one of 'exposed' | 'not_exposed' | 'unresolved'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|title|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, title."
      },
      {
        "selector": "JSXOpeningElement[name.name='Kicker'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|as|children|key|ref|className|style|children)$/]",
        "message": "<Kicker> doesn't accept that prop. Declared props: tone, as, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Kicker'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:muted|primary|danger)$/]",
        "message": "<Kicker> tone must be one of 'muted' | 'primary' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute > JSXIdentifier[name!=/^(?:kicker|title|meta|actions|padded|toolbar|children|key|ref|className|style|children)$/]",
        "message": "<Panel> doesn't accept that prop. Declared props: kicker, title, meta, actions, padded, toolbar, children."
