HYDRADB_URL=http://127.0.0.1:8443
HYDRADB_TOKEN=local-development-token-32-bytes
HYDRADB_NAMESPACE=default
HYDRADB_GRAPH_ID=default
HYDRADB_CELL_ID=cell-0
HYDRADB_TIMEOUT_MS=60000
BLASTRADIUS_PORT=8787
HOST=0.0.0.0

# Optional production bootstrap for a fresh, dedicated HydraDB graph.
BLASTRADIUS_AUTO_INGEST=false
BLASTRADIUS_INGEST_ATTEMPTS=60
BLASTRADIUS_INGEST_RETRY_MS=2000
